# ============================================================
# DEX Quickstart — Environment Variables
# ============================================================
# Copy this file to .env next to docker-compose.quickstart.yml:
#
#   cp .env.quickstart.example .env
#   # Edit .env: set the two REQUIRED variables below
#   docker compose -f docker-compose.quickstart.yml up
#
# REQUIRED (only these two):
#   GROQ_API_KEY      — AI answers (Groq; free tier at console.groq.com)
#   NEXTAUTH_SECRET   — session signing (openssl rand -base64 32)
#
# Everything else (Postgres, Neo4j, API URLs, CORS, embedding provider)
# is set in docker-compose.quickstart.yml and overrides duplicate keys
# in this file. You do not need to configure databases or URLs here.
# ============================================================

# --- REQUIRED ---

# Groq API key for chat / RAG (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# NextAuth session secret (32+ random characters)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace_this_with_a_random_32_plus_char_string

# --- OPTIONAL ---

# GitHub PAT for cloning private repos or higher API rate limits.
# Public repos usually work without this. Set it whenever you need access to private repos.
# https://github.com/settings/tokens/new?scopes=repo
GITHUB_TOKEN=

# --- OPTIONAL: OAuth login (email + password works without any of these) ---
#
# DEX always enables NextAuth "Credentials" (email + password). Sign up at
# /signup, sign in at /login — no GitHub/Google/Microsoft app required.
# Set OAuth vars below only if you want "Sign in with GitHub/Google" buttons.
#
# Verified against frontend/src/app/api/auth/[...nextauth]/route.ts:
#   GitHub:  GITHUB_ID + GITHUB_SECRET
#   Google:  GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
#   Azure:   AZURE_AD_CLIENT_ID + AZURE_AD_CLIENT_SECRET (+ AZURE_AD_TENANT_ID)

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Azure AD (optional)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ============================================================
# After running `docker compose -f docker-compose.quickstart.yml up`:
#
#   1. Wait ~2 minutes for all services to become healthy
#      (watch the logs — backend is the slowest to start)
#   2. Open http://localhost:3000
#   3. Sign up with email + password (no verification email required)
#   4. Complete the brief onboarding (just enter your name)
#   5. Ingest any public GitHub repo and start asking questions
# ============================================================
