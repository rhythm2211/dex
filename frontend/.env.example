# Frontend environment (copy to .env.local)
#
# CLIENT_FETCH_ERROR checklist:
# 1. Frontend running: cd frontend && npm run dev  →  http://localhost:3000
# 2. NEXTAUTH_URL must match the browser URL exactly (localhost vs 127.0.0.1, port 3000 vs 3001)
# 3. NEXTAUTH_SECRET must be set (any long random string)
# 4. Restart `npm run dev` after changing this file
#
# Docker Compose: backend on 8001 — set BACKEND_URL=http://127.0.0.1:8001
# Manual uvicorn on 8000 — use proxy mode (recommended on Windows):

NEXT_PUBLIC_API_URL=/api/backend
INTERNAL_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Direct (no Next proxy): NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32

# OAuth (optional — omit providers you do not use)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
